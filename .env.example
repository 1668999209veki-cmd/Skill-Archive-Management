# Skill archive root directories. Leave blank to use local defaults.
SKILL_ARCHIVE_PROJECT_SKILLS_DIR=
SKILL_ARCHIVE_CODEX_SKILLS_DIR=
SKILL_ARCHIVE_AGENTS_SKILLS_DIR=

# Optional page-pet model settings. Do not put real values in committed files.
SKILL_ARCHIVE_PET_API_BASE=https://api.deepseek.com
SKILL_ARCHIVE_PET_API_KEY={{YOUR_MODEL_API_KEY}}
SKILL_ARCHIVE_PET_MODEL=deepseek-v4-flash
